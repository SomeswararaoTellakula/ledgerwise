# Hindsight (required for the real demo). Cloud: copy the API URL + key from ui.hindsight.vectorize.io
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=
# Optional: pin a bank so memory survives restarts (otherwise a fresh bank per run)
HINDSIGHT_BANK_ID=

# Optional: Groq for natural-language explanations and vendor emails (template fallback otherwise)
GROQ_API_KEY=
LEDGERWISE_MODEL=openai/gpt-oss-120b
